{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Sync Copilot Shared -> .github",
            "type": "shell",
            "command": "powershell.exe",
            "args": [
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}\\powershell\\sync-shared-copilot.ps1",
                "-Verbose"
            ],
            "group": "none",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}


