# --- HTML / XML parsing ------------------------------------------------------
# beautifulsoup4               # Parse HTML or XML documents
# lxml                         # Fast XML/HTML parser (used by beautifulsoup4)

# --- Data / reporting --------------------------------------------------------
# pandas                       # DataFrames, pivot tables, data manipulation
# openpyxl                     # Read and write .xlsx workbooks
# tabulate                     # Pretty-print tables to the terminal

# --- Dates and times ---------------------------------------------------------
# python-dateutil              # Flexible date parsing beyond stdlib datetime

